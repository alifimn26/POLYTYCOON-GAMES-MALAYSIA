{
  "name": "polytycoon-dev-tests",
  "private": true,
  "type": "module",
  "description": "Dev-only test tooling. The game itself is the single static index.html.",
  "scripts": {
    "test:unit": "vitest --run tests/unit",
    "test:explore": "vitest --run tests/exploration",
    "test:explore:original": "node tests/tools/check-baseline.mjs",
    "test:e2e": "playwright test",
    "test:all": "vitest --run tests/unit tests/exploration && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "vitest": "5.0.4"
  }
}
