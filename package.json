{
  "name": "polytycoon-dev-tests",
  "private": true,
  "type": "module",
  "description": "Dev-only test tooling. The game is static files served as-is from GitHub Pages.",
  "scripts": {
    "css:build": "tailwindcss -i src/tailwind.css -o assets/tailwind.css --minify",
    "test:unit": "vitest --run tests/unit",
    "test:all": "vitest --run tests/unit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "tailwindcss": "3.4.17",
    "vitest": "5.0.4"
  }
}
